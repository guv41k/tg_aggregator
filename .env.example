# Токен Telegram-бота администратора (получить у @BotFather)
BOT_TOKEN=

# Токен бота-сборщика (получить у @BotFather)
COLLECTOR_TOKEN=

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tg_aggregator

# Пароль PostgreSQL для Docker Compose (используй символы A-Z, a-z, 0-9, _, -)
POSTGRES_PASSWORD=

# Telegram user_id администраторов через запятую
ADMIN_IDS=123456789,987654321
